{
  "_doc": "検索回帰テストのケース。形式は scripts/check_retrieval.py の冒頭を参照。マニュアル本文は入れない。page_dependent が true のケースだけがページ番号の完全一致に依存する（改版で失敗したらまずここを疑う）。",
  "cases": [
    {"id": "v6plus-ex", "title": "v6プラスの設定例が上位に出る",
     "sub": "ex", "args": ["v6プラス"], "page_dependent": false,
     "expect": {"files": ["ipoe_v6plus_mape.md", "ipoe_v6plus_fixedip.md"], "top_k": 4}},
    {"id": "v6plus-ex-space", "title": "空白ゆれ: 「v6 プラス」でも設定例に当たる",
     "sub": "ex", "args": ["v6 プラス"], "page_dependent": false,
     "expect": {"files": ["ipoe_v6plus_mape.md", "ipoe_v6plus_fixedip.md"], "top_k": 4}},
    {"id": "v6plus-ex-fullwidth", "title": "全角英数: 「ｖ６プラス」でも設定例に当たる",
     "sub": "ex", "args": ["ｖ６プラス"], "page_dependent": false,
     "expect": {"files": ["ipoe_v6plus_mape.md"], "top_k": 4}},
    {"id": "v6plus-grep", "title": "v6プラスの本文検索が仕様書・運用管理編に当たる（0件にならない）",
     "sub": "grep", "args": ["v6プラス"], "page_dependent": false,
     "expect": {"manuals": ["siyou", "cmd_refe_ope"], "min_hits": 5}},
    {"id": "v6plus-grep-space", "title": "空白ゆれ: 「v6 プラス」でも同じマニュアルに当たる",
     "sub": "grep", "args": ["v6 プラス"], "page_dependent": false,
     "expect": {"manuals": ["siyou", "cmd_refe_ope"], "min_hits": 5}},
    {"id": "v6plus-grep-ref", "title": "仕様書でv6プラスが載るページ（代表）",
     "sub": "grep", "args": ["v6プラス", "siyou"], "page_dependent": true,
     "expect": {"refs": ["siyou:20"]}},
    {"id": "ocn-vc-ex", "title": "OCNバーチャルコネクトの設定例が先頭に出る",
     "sub": "ex", "args": ["OCNバーチャルコネクト"], "page_dependent": false,
     "expect": {"files": ["ipoe_ocn_vc.md"], "top_k": 1}},
    {"id": "ipsec-ex", "title": "IPsecの設定例（IKEv1 固定IP・IKEv2）が出る",
     "sub": "ex", "args": ["IPsec"], "page_dependent": false,
     "expect": {"files": ["ipsec_ipsec-01.md", "ipsec_ipsec_ikev2_1.md"], "min_hits": 8}},
    {"id": "vrrp-ex", "title": "VRRPを含む冗長構成の設定例が先頭に出る",
     "sub": "ex", "args": ["VRRP"], "page_dependent": false,
     "expect": {"files": ["redundancy_redundancy-01.md"], "top_k": 1}},
    {"id": "vrrp-cmd", "title": "vrrp 系コマンドが構成定義編にあり、運用管理編に show vrrp がある",
     "sub": "cmd", "args": ["vrrp"], "opts": {"limit": 60}, "page_dependent": false,
     "expect": {"commands": ["vrrp address", "show vrrp"], "manuals": ["cmd_refe_config", "cmd_refe_ope"]}},
    {"id": "ospf-fullwidth-cmd", "title": "全角「ＯＳＰＦ」でも ospf 系コマンドに当たる",
     "sub": "cmd", "args": ["ＯＳＰＦ"], "opts": {"limit": 80}, "page_dependent": false,
     "expect": {"commands": ["router ospf"], "min_hits": 10}},
    {"id": "ospf-cmd-full", "title": "cmd --full: 【機能】と入力形式、パラメータ表が付く",
     "sub": "cmd", "args": ["^router ospf"], "opts": {"full": true}, "page_dependent": false,
     "expect": {"commands": ["router ospf"],
                "contains": ["【機能】", "【パラメータ】\\n\\s+\\S", "^\\s+router ospf"]}},
    {"id": "ospf-cmd-ref", "title": "router ospf の出典ページ（代表）",
     "sub": "cmd", "args": ["^router ospf"], "page_dependent": true,
     "expect": {"command_refs": ["router ospf@cmd_refe_config:195"]}},
    {"id": "bgp", "title": "BGP: eBGPの設定例と router bgp コマンド",
     "sub": "ex", "args": ["BGP"], "page_dependent": false,
     "expect": {"files": ["routing_ebgp.md"], "top_k": 4}},
    {"id": "qos-ex", "title": "QoS: シェーピング・優先制御の設定例が出る",
     "sub": "ex", "args": ["QoS"], "page_dependent": false,
     "expect": {"files": ["interface_f70_CBQ.md", "interface_f70_priq.md"], "top_k": 3}},
    {"id": "lbo-app-profile", "title": "LBO新体系: app-profile の設定例とコマンド",
     "sub": "ex", "args": ["app-profile"], "page_dependent": false,
     "expect": {"files": ["lbo_index.md"], "top_k": 1}},
    {"id": "lbo-profile", "title": "LBO旧体系: lbo-profile の設定例が出る（LBO一覧と各社動的IP）",
     "sub": "ex", "args": ["lbo-profile"], "page_dependent": false,
     "expect": {"files": ["lbo_index.md", "ipoe_mape_lbo.md"], "top_k": 4}},
    {"id": "lbo-dns-snooping-cmd", "title": "dns-snooping 系コマンドが新旧両モードで索引にある",
     "sub": "cmd", "args": ["^dns-snooping"], "opts": {"manual": "cmd_refe_config"}, "page_dependent": false,
     "expect": {"commands": ["dns-snooping enable", "dns-snooping expire"],
                "contains": ["LBO プロファイル設定モード", "アプリプロファイル設定モード"]}},
    {"id": "container-ex", "title": "コンテナ: Remote Wireshark と ZTP の説明書が設定例に入っている",
     "sub": "ex", "args": ["コンテナ"], "page_dependent": false,
     "expect": {"files": ["container_remote-wireshark.md", "container_ztp-script.md"]}},
    {"id": "softflowd-grep", "title": "softflowd 説明書の本文検索",
     "sub": "grep", "args": ["softflowd", "softflowd_man"], "page_dependent": false,
     "expect": {"manuals": ["softflowd_man"], "min_hits": 5}},
    {"id": "squid-grep", "title": "squid 説明書の本文検索",
     "sub": "grep", "args": ["squid", "squid_man"], "page_dependent": false,
     "expect": {"manuals": ["squid_man"], "min_hits": 5}},
    {"id": "container-enable-cmd-ref", "title": "container enable の出典ページ（代表）",
     "sub": "cmd", "args": ["^container enable"], "page_dependent": true,
     "expect": {"command_refs": ["container enable@cmd_refe_config:1131"]}},
    {"id": "container-backup-absent", "title": "container backup は説明書に無く、コマンドリファレンスに有る（SKILL.md の記載どおり）",
     "sub": "grep", "args": ["container backup", "lxc_app_man"], "page_dependent": false,
     "expect": {"rc": 1}},
    {"id": "message-grep", "title": "ログ文言: 「link up」がメッセージ集に当たる",
     "sub": "grep", "args": ["link up", "message"], "page_dependent": false,
     "expect": {"manuals": ["message"], "min_hits": 1}},
    {"id": "message-ref", "title": "ログ文言 Fail to link up の出典ページ（代表）",
     "sub": "grep", "args": ["Fail to link up", "message"], "page_dependent": true,
     "expect": {"refs": ["message:420"]}},
    {"id": "mib-ex", "title": "MIB取得の設定例が先頭に出る",
     "sub": "ex", "args": ["MIB"], "page_dependent": false,
     "expect": {"files": ["other_mib.md"], "top_k": 3}},
    {"id": "ipv6-space-grep", "title": "空白ゆれ: 「IPv6アドレス」が「IPv6 アドレス」にも当たる",
     "sub": "grep", "args": ["IPv6アドレス", "kinou"], "page_dependent": false,
     "expect": {"manuals": ["kinou"], "min_hits": 5, "contains": ["IPv6 アドレス"]}},
    {"id": "mode-wrap-blank", "title": "動作モードの折り返しに空行が挟まっても途中で切れない（container-use 等）",
     "sub": "cmd", "args": ["^(container-use|vlan-id)$"], "page_dependent": false,
     "expect": {"commands": ["container-use", "vlan-id"],
                "contains": ["container-use  \\[[^\\]]*trunk-channel サブインタフェース設定モード\\]",
                             "vlan-id  \\[[^\\]]*trunk-channel サブインタフェース設定モード\\]"]}},
    {"id": "mode-no-table","title": "動作モードにパラメータ表が混ざらない（表が混ざっていた4コマンド）",
     "sub": "cmd", "args": ["^(privilege|clock summer-time|exec-timeout|telnet-server no-shutdown)$"],
     "opts": {"manual": "cmd_refe_config"}, "page_dependent": false,
     "expect": {"commands": ["privilege", "clock summer-time", "exec-timeout", "telnet-server no-shutdown"],
                "heading_not_contains": ["設定範囲", "設定内容", "省略時", "パラメータ"]}},
    {"id": "params-attached", "title": "cmd --full にパラメータ表が付く（表を持つコマンド）",
     "sub": "cmd", "args": ["^privilege$"], "opts": {"full": true}, "page_dependent": false,
     "expect": {"commands": ["privilege"], "contains": ["【パラメータ】\\n\\s+\\S"]}},
    {"id": "page-config", "title": "page: 構成定義編 p.195 を返す（代表）",
     "sub": "page", "args": ["cmd_refe_config", "195"], "page_dependent": true,
     "expect": {"pages": ["cmd_refe_config:195"], "contains": ["router ospf"]}},
    {"id": "page-range-lxc", "title": "page: コンテナのお知らせ p.1-2 の範囲指定（代表）",
     "sub": "page", "args": ["lxc_check_change", "1-2"], "page_dependent": true,
     "expect": {"pages": ["lxc_check_change:1", "lxc_check_change:2"]}}
  ]
}
